{
  "name": "teamcal",
  "version": "1.0.0",
  "description": "Shared team calendar with sub-calendars, access links and multiple views (Teamup-style).",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "build": "node scripts/build-static.js",
    "preview": "npm run build && npx --yes serve@14 dist"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "sql.js": "^1.10.3"
  }
}
